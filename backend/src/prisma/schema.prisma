// This is your Prisma schema file
// Learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  admin
  field_agent
  quality_manager
  viewer
}

enum LotStatus {
  harvest
  processing
  processed
  transit
  exported
  rejected
}

enum ShipmentStatus {
  preparing
  in_transit
  delivered
  cancelled
}

enum CertificationType {
  organic
  fair_trade
  eudr
  rainforest
  other
}

enum DocumentType {
  phytosanitary
  lab_report
  organic_cert
  fair_trade_cert
  eudr_proof
  invoice
  purchase_order
  tech_spec
  other
}

enum NotificationType {
  cert_expiring
  lot_blocked
  quality_anomaly
  shipment_delayed
  new_lot
  system
}

enum PurchaseOrderStatus {
  pending       // En attente
  in_production // En cours de conditionnement
  ready         // Prêt à expédier
  shipped       // Expédié
  delivered     // Livré
  cancelled     // Annulé
}

// ─── CLIENT ──────────────────────────────────────────────────────────────────
model Client {
  id        String   @id @default(uuid())
  name      String
  country   String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  purchaseOrders PurchaseOrder[]

  @@map("clients")
}

// ─── PURCHASE ORDER ───────────────────────────────────────────────────────────
model PurchaseOrder {
  id              String              @id @default(uuid())
  poNumber        String              @unique @map("po_number")  // ex: PO-2026-001 (ERP ou manuel)
  clientId        String              @map("client_id")
  lotId           String              @map("lot_id")             // Lot source
  quantityKg      Float               @map("quantity_kg")        // Quantité demandée
  destination     String                                          // Pays/port de destination
  deliveryDate    DateTime            @map("delivery_date")      // Date livraison souhaitée
  status          PurchaseOrderStatus @default(pending)

  // Spécifications techniques (cahier des charges)
  specGrade         String?  @map("spec_grade")          // 1er, 2ème, 3ème, 4ème
  specHumidityMin   Float?   @map("spec_humidity_min")   // Humidité cible min (%)
  specHumidityMax   Float?   @map("spec_humidity_max")   // Humidité cible max (%)
  specLengthMin     Float?   @map("spec_length_min")     // Longueur min (cm)
  specCertifications String[] @default([]) @map("spec_certifications") // Bio, FairTrade, EUDR...
  specPackaging     String?  @map("spec_packaging")      // carton, sac, vrac
  specNotes         String?  @map("spec_notes")          // Notes libres

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  client            Client              @relation(fields: [clientId], references: [id])
  lot               Lot                 @relation(fields: [lotId], references: [id])
  conditioningOrders ConditioningOrder[]
  subLots           Lot[]               @relation("PurchaseOrderSubLots")

  @@map("purchase_orders")
}

// ─── USER ─────────────────────────────────────────────────────────────────────
model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  firstName    String
  lastName     String
  role         Role     @default(viewer)
  isActive     Boolean  @default(true)
  avatarUrl    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  notifications Notification[]

  @@map("users")
}

// ─── PRODUCT ──────────────────────────────────────────────────────────────────
model Product {
  id          String   @id @default(uuid())
  name        String
  variety     String?
  category    String
  unit        String   @default("kg")
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  lots Lot[]

  @@map("products")
}

// ─── PRODUCER ─────────────────────────────────────────────────────────────────
model Producer {
  id           String   @id @default(uuid())
  name         String
  country      String   @default("Madagascar")
  region       String
  village      String?
  latitude     Float?
  longitude    Float?
  areaHectares Float?
  email        String?
  telephone    String?
  description  String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  lots           Lot[]
  certifications Certification[]
  photos         ProducerPhoto[]
  documents      Document[]

  @@map("producers")
}

// ─── LOT ──────────────────────────────────────────────────────────────────────
model Lot {
  id               String    @id @default(uuid())
  lotNumber        String    @unique
  producerId       String
  productId        String
  harvestDate      DateTime
  quantityKg       Float                        // Quantité totale initiale
  availableKg      Float?    @map("available_kg") // Quantité restante disponible (calculée)
  status           LotStatus @default(harvest)
  qrCodeUrl        String?
  qualityScore     Float?
  notes            String?
  harvestLatitude  Float?
  harvestLongitude Float?
  conditioningType String?   @map("conditioning_type")

  // Gestion sous-lots
  parentLotId      String?   @map("parent_lot_id")  // null = lot racine
  subLotIndex      String?   @map("sub_lot_index")  // A, B, C...
  purchaseOrderId  String?   @map("purchase_order_id") // PO qui a généré ce sous-lot

  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  producer           Producer            @relation(fields: [producerId], references: [id])
  product            Product             @relation(fields: [productId], references: [id])
  parentLot          Lot?                @relation("LotSubLots", fields: [parentLotId], references: [id])
  subLots            Lot[]               @relation("LotSubLots")
  originPO           PurchaseOrder?      @relation("PurchaseOrderSubLots", fields: [purchaseOrderId], references: [id])
  processingSteps    ProcessingStep[]
  conditioningOrders ConditioningOrder[]
  purchaseOrders     PurchaseOrder[]
  shipmentLots       ShipmentLot[]
  scanLogs           ScanLog[]
  photos             LotPhoto[]
  documents          Document[]
  lotEvents          LotEvent[]          // Historique complet

  @@map("lots")
}

// ─── LOT EVENT (Historique) ───────────────────────────────────────────────────
model LotEvent {
  id          String   @id @default(uuid())
  lotId       String   @map("lot_id")
  eventType   String   @map("event_type")  // created, split, conditioning_started, conditioning_done, shipped, delivered
  description String
  quantityKg  Float?   @map("quantity_kg") // Quantité concernée
  relatedId   String?  @map("related_id")  // ID du PO, conditionnement, expédition concerné
  relatedType String?  @map("related_type") // "purchase_order" | "conditioning" | "shipment"
  createdBy   String?  @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")

  lot Lot @relation(fields: [lotId], references: [id], onDelete: Cascade)

  @@index([lotId])
  @@map("lot_events")
}

// ─── PROCESSING STEP ──────────────────────────────────────────────────────────
model ProcessingStep {
  id             String    @id @default(uuid())
  lotId          String
  stepName       String
  stepOrder      Int
  startedAt      DateTime
  endedAt        DateTime?
  operatorName   String?
  location       String?
  inputQuantity  Float?
  outputQuantity Float?
  qualityScore   Float?
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  lot    Lot               @relation(fields: [lotId], references: [id], onDelete: Cascade)
  photos ProcessingPhoto[]

  @@map("processing_steps")
}

// ─── SHIPMENT ─────────────────────────────────────────────────────────────────
model Shipment {
  id                String         @id @default(uuid())
  reference         String         @unique
  carrierName       String
  containerNumber   String?
  depot             String?
  departureLocation String
  arrivalLocation   String
  departureDate     DateTime?
  expectedArrival   DateTime?
  actualArrival     DateTime?
  status            ShipmentStatus @default(preparing)
  transportMode     String?        @default("maritime") @map("transport_mode") // maritime | aerien
  notes             String?
  qrCodeUrl         String?        @map("qr_code_url")
  totalWeightKg     Float?         @map("total_weight_kg")
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  shipmentLots ShipmentLot[]
  documents    Document[]

  @@map("shipments")
}

// ─── SHIPMENT LOT ─────────────────────────────────────────────────────────────
model ShipmentLot {
  id         String   @id @default(uuid())
  shipmentId String
  lotId      String
  createdAt  DateTime @default(now())

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  lot      Lot      @relation(fields: [lotId], references: [id], onDelete: Cascade)

  @@unique([shipmentId, lotId])
  @@map("shipment_lots")
}

// ─── CERTIFICATION ────────────────────────────────────────────────────────────
model Certification {
  id         String            @id @default(uuid())
  producerId String
  type       CertificationType
  issuer     String
  issuedAt   DateTime
  expiresAt  DateTime
  status     String            @default("active")
  fileUrl    String?
  notes      String?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  producer Producer @relation(fields: [producerId], references: [id], onDelete: Cascade)

  @@map("certifications")
}

// ─── DOCUMENT ─────────────────────────────────────────────────────────────────
model Document {
  id         String       @id @default(uuid())
  name       String
  docType    DocumentType
  fileUrl    String
  fileSize   Int?
  mimeType   String?
  lotId      String?
  producerId String?
  stepId     String?
  shipmentId String?
  notes      String?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  lot      Lot?      @relation(fields: [lotId], references: [id], onDelete: SetNull)
  producer Producer? @relation(fields: [producerId], references: [id], onDelete: SetNull)
  shipment Shipment? @relation(fields: [shipmentId], references: [id], onDelete: SetNull)

  @@map("documents")
}

// ─── PRODUCER PHOTO ───────────────────────────────────────────────────────────
model ProducerPhoto {
  id         String   @id @default(uuid())
  producerId String
  url        String
  caption    String?
  isPrimary  Boolean  @default(false)
  createdAt  DateTime @default(now())

  producer Producer @relation(fields: [producerId], references: [id], onDelete: Cascade)

  @@map("producer_photos")
}

// ─── LOT PHOTO ────────────────────────────────────────────────────────────────
model LotPhoto {
  id        String   @id @default(uuid())
  lotId     String
  url       String
  caption   String?
  createdAt DateTime @default(now())

  lot Lot @relation(fields: [lotId], references: [id], onDelete: Cascade)

  @@map("lot_photos")
}

// ─── PROCESSING PHOTO ─────────────────────────────────────────────────────────
model ProcessingPhoto {
  id        String   @id @default(uuid())
  stepId    String
  url       String
  caption   String?
  createdAt DateTime @default(now())

  step ProcessingStep @relation(fields: [stepId], references: [id], onDelete: Cascade)

  @@map("processing_photos")
}

// ─── NOTIFICATION ─────────────────────────────────────────────────────────────
model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  data      Json?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

// ─── SCAN LOG ─────────────────────────────────────────────────────────────────
model ScanLog {
  id              String   @id @default(uuid())
  lotId           String   @map("lot_id")
  ipAddress       String?  @map("ip_address")
  country         String?
  city            String?
  device          String?
  userAgent       String?  @map("user_agent")
  referer         String?
  isSuspicious    Boolean  @default(false) @map("is_suspicious")
  suspicionReason String?  @map("suspicion_reason")
  latitude        Float?
  longitude       Float?
  createdAt       DateTime @default(now()) @map("created_at")

  lot Lot @relation(fields: [lotId], references: [id], onDelete: Cascade)

  @@index([lotId])
  @@index([createdAt])
  @@map("scan_logs")
}

// ─── CONDITIONING ORDER ───────────────────────────────────────────────────────
model ConditioningOrder {
  id              String             @id @default(uuid())
  lotId           String             @map("lot_id")
  purchaseOrderId String?            @map("purchase_order_id") // PO associé
  quantityKg      Float?             @map("quantity_kg")       // Quantité à conditionner (sous-lot)
  productType     String             @map("product_type")
  destination     String?
  status          String             @default("en_cours")
  passNumber      Int                @default(1) @map("pass_number")
  createdBy       String             @map("created_by")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  lot           Lot                @relation(fields: [lotId], references: [id])
  purchaseOrder PurchaseOrder?     @relation(fields: [purchaseOrderId], references: [id])
  steps         ConditioningStep[]

  @@map("conditioning_orders")
}

// ─── CONDITIONING STEP ────────────────────────────────────────────────────────
model ConditioningStep {
  id             String            @id @default(uuid())
  orderId        String            @map("order_id")
  stepName       String            @map("step_name")
  stepOrder      Int               @map("step_order")
  status         String            @default("en_attente")
  startedAt      DateTime?         @map("started_at")
  completedAt    DateTime?         @map("completed_at")
  operatorName   String?           @map("operator_name")
  validatedBy    String?           @map("validated_by")
  validatedAt    DateTime?         @map("validated_at")
  quantityIn     Float?            @map("quantity_in")
  quantityOut    Float?            @map("quantity_out")
  humidityIn     Float?            @map("humidity_in")
  humidityOut    Float?            @map("humidity_out")
  moldPercent    Float?            @map("mold_percent")
  splitPercent   Float?            @map("split_percent")
  phenolPercent  Float?            @map("phenol_percent")
  pocketPercent  Float?            @map("pocket_percent")
  metalDetResult String?           @map("metal_det_result")
  boxCount       Int?              @map("box_count")
  notes          String?
  isConform      Boolean?          @map("is_conform")
  documents      String[]          @default([])
  temperature    Float?            @map("temperature")
  vanillineRate  Float?            @map("vanilline_rate")
  classification String?           @map("classification")
  isFendue       Boolean?          @map("is_fendue")
  bundleType     String?           @map("bundle_type")
  bundleCount    Int?              @map("bundle_count")

  order ConditioningOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("conditioning_steps")
}
